# Copy this file to .streamlit/secrets.toml (gitignored) and fill in real values.
# On Streamlit Community Cloud, paste the same keys under App settings > Secrets.

# PostgreSQL connection address (Supabase transaction pooler, port 6543).
# Leave out locally to use the SQLite file instead.
DATABASE_URL = "postgresql+psycopg://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres"

# Hugging Face Inference Providers token. Without it the app runs with AI turned off.
HF_TOKEN = "hf_your_token_here"

# Model name and provider on Hugging Face Inference Providers.
LLM_MODEL = "Qwen/Qwen3-8B"
LLM_PROVIDER = "auto"

# Maximum number of model calls per day for the whole app.
LLM_DAILY_CAP = 200
